# Online: install Prisma Postgres through Vercel Storage.
# Local: npm run dev creates a persistent local Prisma Postgres automatically.
DATABASE_URL=
# Optional direct connection for migrations. Falls back to DATABASE_URL.
DIRECT_URL=
BETTER_AUTH_SECRET=
CAVEAT_SETUP_KEY=
BETTER_AUTH_URL=http://localhost:3000
# Set to the URL of your published template repository for /create.
CAVEAT_TEMPLATE_REPOSITORY=
# Vercel previews MUST have their own database URL and their own auth secrets.
PREVIEW_DATABASE_URL=
PREVIEW_DIRECT_URL=
