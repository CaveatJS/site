{
  "name": "caveat-publication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/deploy.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "owner:recover": "tsx scripts/recover.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "format": "prettier --write src scripts tests e2e *.ts *.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/html": "3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.3",
    "dotenv": "17.4.2",
    "happy-dom": "20.14.0",
    "lucide-react": "1.42.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "sanitize-html": "2.17.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@prisma/dev": "0.25.2",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaveatJS/site.git"
  }
}
